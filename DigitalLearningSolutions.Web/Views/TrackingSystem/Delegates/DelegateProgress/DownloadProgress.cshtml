@using DigitalLearningSolutions.Web.ViewModels.TrackingSystem.Delegates.DelegateProgress
@model PreviewProgressViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head id="Head1">
    <title>
        Delegate progress summary
    </title>
    <style type="text/css">
            body, html {
                background-color: #D9ECFF !important;
            }

            .col {
                position: relative;
                width: 100%;
                padding-right: 15px;
                padding-left: 15px;
                min-width: 0;
                max-width: 100%;
            }

            .row {
                display: -ms-flexbox;
                display: flex;
                -ms-flex-wrap: wrap;
                flex-wrap: wrap;
                margin-right: -15px;
                margin-left: -15px;
                width: 100%;
            }

            .container {
                width: 100%;
                padding-right: 15px;
                padding-left: 15px;
                margin-right: auto;
                margin-left: auto;
                display: -ms-flexbox;
                display: flex;
                -ms-flex-wrap: wrap;
                flex-wrap: wrap;
                -ms-flex-align: center;
                align-items: center;
                -ms-flex-pack: justify;
                justify-content: space-between;
                flex-direction: column;
                max-width: 1140px;
            }

            .card {
                position: relative;
                display: -ms-flexbox;
                display: flex;
                -ms-flex-direction: column;
                flex-direction: column;
                min-width: 0;
                word-wrap: break-word;
                background-color: #fff;
                background-clip: border-box;
                border: 1px solid rgba(0,0,0,.125);
                border-radius: .25rem
            }

            .card-body {
                -ms-flex: 1 1 auto;
                flex: 1 1 auto;
                min-height: 1px;
                padding: 1.25rem
            }

            .card-default {
                border-color: #00529E !important;
                border-style: solid !important;
                border-width: 3px !important;
            }

            *,
            *::before,
            *::after {
                text-shadow: none !important;
                box-shadow: none !important;
            }

            body {
                min-width: 992px !important;
            }

            .container {
                min-width: 992px !important;
            }

            .heading2 {
                font-size: 2rem !important;
            }

            .heading3 {
                font-size: 1.75rem;
            }

            .heading4 {
                font-size: 1.5rem;
                font-weight: 600 !important;
            }

            .heading2, .heading3, heading4 {
                line-height: 1.2;
                display: block;
                font-weight: 600 !important;
                margin-top: 0;
                margin-bottom: 16px;
                color: #000000;
                font-family: Verdana, Arial, Helvetica, sans-serif !important;
            }

            .progress-table {
                width: 100%;
                margin-bottom: 40px;
                border-spacing: 0;
                border-collapse: collapse;
                vertical-align: top;
            }

                .progress-table th,
                .progress-table td {
                    padding: 8px 16px 8px 0;
                    border-bottom: 1px solid #d8dde0;
                    font-size: 16px;
                    line-height: 1.5;
                    text-align: left;
                    vertical-align: top;
                }

                .progress-table th {
                    border-bottom: 2px solid #d8dde0;
                    font-weight: 600;
                }

                    .progress-table th:last-child,
                    .progress-table td:last-child {
                        padding-right: 0;
                    }

            .progress-table--summary td:first-child {
                width: 25%;
            }

            .progress-table--summary td {
                border-bottom: 0;
            }

                .progress-table--summary td + td {
                    padding-left: 20px;
                }

            .progress-table--summary tr {
                height: 35px;
            }

            .progress-table--summary .status-value {
                font-weight: bold;
            }

            .progress-table--sections th,
            .progress-table--sections td {
                width: 25%;
            }

            .progress-table .passed-outcome {
                color: #0e6935;
                font-weight: normal;
            }

            .current-date {
                height: 40px;
            }

            .progress-title {
                color: #000066 !important;
                font-weight: bold !important;
            }

            @@media print {
                .progress-table th,
                .progress-table td {
                    font-size: 13pt;
                    line-height: 1.25;
                }
            }
    </style>
</head>
<body>
    <div class="maincontentcontainer">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="card card-default">
                        <div class="card-body">
                            <div>
                                <div class="current-date">
                                    Progress as at: <span id="lblCurrentDate">@DateTime.Now.ToString("dd MMMM yyyy")</span>
                                </div>
                                <h2 class="heading2 progress-title">Progress Summary for @Model.CandidateName (@Model.CandidateNumber)</h2>
                                <h3 class="heading3">@Model.CourseName</h3>
                                @if (Model.IsAssessed)
                                {
                                    <h4 class="heading4">To complete this course, you must pass all post learning assessments</h4>
                                }
                                else if (Model.DiagCompletionThreshold > 0 && Model.TutCompletionThreshold > 0 && (!Model.IsAssessed))
                                {
                                    <h4 class="heading4">To complete this course, you must achieve @Model.DiagCompletionThreshold% in the diagnostic assessment and complete @Model.TutCompletionThreshold% of the learning materials")</h4>
                                }
                                else if (Model.DiagCompletionThreshold == 0 && (!Model.IsAssessed))
                                {
                                    <h4 class="heading4">To complete this course, you must complete @Model.TutCompletionThreshold% of the learning materials</h4>
                                }
                                else if (Model.TutCompletionThreshold == 0 && (!Model.IsAssessed))
                                {
                                    <h4 class="heading4">To complete this course, you must achieve @Model.DiagCompletionThreshold% in the diagnostic assessment</h4>
                                }
                                <br />

                                <table class="progress-table progress-table--summary">
                                    <tr>
                                        <td>
                                            Course Status:
                                        </td>
                                        <td class="status-value">
                                            <span>@Model.CourseStatus</span>
                                        </td>
                                    </tr>
                                    @if (Model.DiganosticScorePercent != null && Model.DiganosticScorePercent > 0)
                                    {
                                        <tr>
                                            <td>
                                                Diagnostic Score:
                                            </td>
                                            <td>
                                                @Model.DiganosticScorePercent%
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.LearningCompletedPercent > 0)
                                    {

                                        <tr>
                                            <td>
                                                Learning Completed:
                                            </td>
                                            <td>
                                                <span>@Model.LearningCompletedPercent%</span>
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td>
                                            Assessments Passed:
                                        </td>
                                        <td>
                                            <span>@Model.AssessmentsPassed</span>
                                        </td>
                                    </tr>
                                </table>
                                <br />

                                <table role="table" class="progress-table progress-table--sections">
                                    <tr>
                                        <th align="left">
                                            Section
                                        </th>
                                        <th align="left">
                                            Diagnostic Score
                                        </th>
                                        <th align="left">
                                            Learning % / time
                                        </th>
                                        <th align="left">
                                            Post Learning Assessment
                                        </th>
                                    </tr>
                                    <tbody>
                                        @foreach (var entry in Model.SectionDetails)
                                        {
                                            <tr>
                                                <td>
                                                    @entry.SectionName
                                                </td>
                                                <td>
                                                    @(entry.DiagAttempts > 0 ?
                                                        @entry.SecScore.ToString() + " / " + @entry.SecOutOf.ToString()
                                                        : "Not attempted".ToString())
                                                </td>
                                                <td>
                                                    @(entry.PCComplete.ToString() + "% complete " + @entry.TimeMins.ToString() + " mins")
                                                </td>
                                                <td>
                                                    @{
                                                        var result = "";
                                                        if (entry.AttemptsPL > 0) result = @entry.MaxScorePL.ToString() + "% - " + @entry.AttemptsPL.ToString() + " attempt(s) ";
                                                        if (entry.AttemptsPL == 0 && entry.IsAssessed) result += "Not attempted";
                                                        if (entry.AttemptsPL > 0 && entry.PLPassed && entry.IsAssessed) result += "PASSED";
                                                        if (entry.AttemptsPL > 0 && !entry.PLPassed && entry.IsAssessed) result += "FAILED";
                                                    }
                                                    @result
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (Model.SectionDetails.Where(pass => pass.PLPassed).Any())
                                {
                                    <h2 class="heading2">Achievements</h2>
                                    <h4 class="heading4">The following post learning assessments have been passed:</h4>
                                    <br />
                                    <table role="table" class="progress-table">
                                        <tr>
                                            <th align="left">
                                                Assessment
                                            </th>
                                            <th align="left">
                                                Outcome
                                            </th>
                                        </tr>
                                        <tbody>
                                            @foreach (var entry in Model.SectionDetails.Where(pass => pass.PLPassed))
                                            {
                                                <tr>
                                                    <td>
                                                        @entry.SectionName
                                                    </td>
                                                    <td class="passed-outcome">
                                                        @("PASSED")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
